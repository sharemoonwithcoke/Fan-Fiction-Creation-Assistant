{
  "name": "@fanfic/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fanfic/shared": "workspace:*",
    "@prisma/client": "^5.14.0",
    "busboy": "^1.6.0",
    "fastify": "^4.27.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "fastify-plugin": "^4.5.1",
    "redis": "^4.6.14",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/busboy": "^1.5.4",
    "@types/node": "^20.14.0",
    "prisma": "^5.14.0",
    "tsx": "^4.13.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
